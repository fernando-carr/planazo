---
interface Props {
	number: number;
	title: string;
	description: string;
	isLast?: boolean;
}

const { number, title, description, isLast = false } = Astro.props;
---

<div class="flex gap-4 lg:gap-6">
	<!-- Indicator -->
	<div class="flex flex-col items-center">
		<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-full bg-primary flex items-center justify-center shrink-0">
			<span class="font-heading text-dark-card text-sm lg:text-base font-normal">{String(number).padStart(2, '0')}</span>
		</div>
		{!isLast && (
			<div class="w-[3px] h-12 lg:h-[60px] bg-primary-40"></div>
		)}
	</div>

	<!-- Content -->
	<div class="flex flex-col gap-2 pt-2">
		<h3 class="font-heading text-text-heading text-lg lg:text-2xl font-normal">{title}</h3>
		<p class="text-sm lg:text-[0.9375rem] leading-relaxed">{description}</p>
	</div>
</div>
