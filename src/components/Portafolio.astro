---
import SectionTitle from './ui/SectionTitle.astro';
import PortfolioCard from './PortfolioCard.astro';

const projects = [
	{ name: 'MUÉVETE CON\nHAVANA CLUB', tag: 'Audiovisual', from: '#333333' },
	{ name: 'HABANOS WORLD\nCHALLENGE CUBA', tag: 'Audiovisual', from: '#444444' },
	{ name: 'VIAJES CUBA\nGRUPO EMPRESARIAL', tag: 'Audiovisual', from: '#555555' },
	{ name: 'GELMA', tag: 'Espacios', from: '#3A3A3A' },
	{ name: 'CLASE', tag: 'Espacios', from: '#4A4A4A' },
	{ name: 'ESPACIOS, PRODUCTOS\nY COBERTURA DE EVENTOS', tag: 'Eventos', from: '#505050' },
];
---

<section id="portafolio" class="bg-white px-5 md:px-10 lg:px-[120px] py-[60px] md:py-20 lg:py-[100px] flex flex-col gap-8 md:gap-10 lg:gap-12">
	<SectionTitle
		title="PORTAFOLIO"
		subtitle="Algunos de nuestros trabajos más destacados."
	/>

	<div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 md:gap-3 lg:gap-4">
		{projects.map((project) => (
			<PortfolioCard
				name={project.name}
				tag={project.tag}
				gradientFrom={project.from}
				class="h-[160px] md:h-[220px] lg:h-[300px]"
			/>
		))}
	</div>
</section>
