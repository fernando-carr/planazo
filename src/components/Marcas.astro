---
import BrushStroke from './ui/BrushStroke.astro';
import SectionTitle from './ui/SectionTitle.astro';

const brands = [
	'MINTUR', 'HAVANA CLUB', 'MGM MUTHU HOTELS', 'MATULES', 'WOMY', 'CLASE',
	'GELMA', 'DAIQUIRI TOURS', 'TROPICARGO', 'VIAZUL', 'SANTA MARÍA FEST',
	'SUPER EXITUS', 'DONGFENG', 'ICRT', 'SUCHEL CAMACHO', 'GUAJIRITOS',
	'ICAIC', 'GAVIOTA', 'HABANOS', 'CUBANACÁN', 'MARLIN', 'CARACOL',
	'CERVECERÍA CUBANA', 'BUCANERO', 'ROC HOTELS', 'GRAN CARIBE',
	'VIAJES CUBA', 'MARINA HEMINGWAY', 'LOLA BARCELONA', 'AMISTUR',
];
---

<section class="bg-white px-5 md:px-10 lg:px-[120px] py-10 md:py-[60px] lg:py-20 flex flex-col gap-6 md:gap-8 overflow-hidden">
	<!-- <div>
		<h2 class="font-heading text-text-heading font-normal text-2xl md:text-[1.75rem] lg:text-4xl leading-none">
			MARCAS QUE HAN CONFIADO
		</h2>
		<BrushStroke width={80} height={4} class="mt-4 md:mt-5 lg:w-[80px] lg:h-[5px]" />
	</div> -->
	<SectionTitle
		title="MARCAS QUE HAN CONFIADO"
	/>

	<!-- Marquee Container -->
	<div class="overflow-hidden">
		<div class="flex animate-marquee w-max">
			{/* First copy */}
			<div class="flex shrink-0 items-center gap-6 md:gap-8 lg:gap-10 pr-6 md:pr-8 lg:pr-10">
				{brands.map((brand, i) => (
					<>
						<span class="text-text-muted font-body text-xs md:text-[0.8125rem] lg:text-sm font-bold tracking-[2px] whitespace-nowrap">{brand}</span>
						{i < brands.length - 1 && <span class="text-border text-lg lg:text-xl">·</span>}
					</>
				))}
			</div>
			{/* Duplicate for seamless loop */}
			<div class="flex shrink-0 items-center gap-6 md:gap-8 lg:gap-10 pr-6 md:pr-8 lg:pr-10">
				{brands.map((brand, i) => (
					<>
						<span class="text-text-muted font-body text-xs md:text-[0.8125rem] lg:text-sm font-bold tracking-[2px] whitespace-nowrap">{brand}</span>
						{i < brands.length - 1 && <span class="text-border text-lg lg:text-xl">·</span>}
					</>
				))}
			</div>
		</div>
	</div>
</section>
