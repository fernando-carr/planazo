---
import { PenTool, BookOpen, Building2, Video, Megaphone, Printer, Eye, LayoutGrid } from '@lucide/astro';

interface Props {
	icon: string;
	title: string;
	description: string;
	class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;

const iconMap: Record<string, any> = {
	'pen-tool': PenTool,
	'book-open': BookOpen,
	'building-2': Building2,
	'video': Video,
	'megaphone': Megaphone,
	'printer': Printer,
	'eye': Eye,
	'layout-grid': LayoutGrid,
};

const IconComponent = iconMap[icon];
---

<div class:list={['flex flex-col gap-4 p-6 lg:p-8 border border-border', className]}>
	{IconComponent && <IconComponent size={28} class="text-primary lg:size-8" />}
	<h3 class="font-body font-semibold text-text-heading text-[0.9375rem] lg:text-lg">{title}</h3>
	<p class="text-xs lg:text-sm leading-relaxed">{description}</p>
</div>
