---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Estudios Planazo — Estrategia, Contenido y Comunicación Integral' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/planazo/images/logo.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Estudios Planazo — Academia Audiovisual, Comunidad Creativa y Agencia de Contenido. Estrategia, creatividad y producción audiovisual." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body class="font-body text-text-body behavior-smooth">
		<slot />
	</body>
</html>
